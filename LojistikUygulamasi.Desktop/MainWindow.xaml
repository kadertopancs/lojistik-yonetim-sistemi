<Window x:Class="LojistikUygulamasi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lojistik Yönetim Sistemi"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17243A">
            <StackPanel Margin="20">
                <TextBlock Text="LOGISTICS"
                           Foreground="White" FontSize="23"
                           FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Text="YÖNETİM SİSTEMİ"
                           Foreground="#91A4C2" FontSize="10"
                           Margin="2,0,0,35"/>

                <TextBlock Text="ANA MENÜ" Foreground="#91A4C2"
                           FontSize="11" Margin="0,0,0,12"/>

                <Button Content="▦   Genel Bakış" Height="42"
                        Margin="0,0,0,8" Background="#293B57"
                        Foreground="White" BorderThickness="0"/>
                <Button Content="▣   Araç Yönetimi" Height="42"
                        Margin="0,0,0,8" Background="#315D91"
                        Foreground="White" BorderThickness="0"/>
                <Button Content="⇄   Sevkiyatlar" Height="42"
                        Margin="0,0,0,8" Background="Transparent"
                        Foreground="#D5DEEB" BorderThickness="0"/>
                <Button Content="▤   Konteynerler" Height="42"
                        Margin="0,0,0,8" Background="Transparent"
                        Foreground="#D5DEEB" BorderThickness="0"/>
                <Button Content="₺   Maliyetler" Height="42"
                        Background="Transparent" Foreground="#D5DEEB"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Araç Yönetimi" FontSize="28"
                           FontWeight="Bold" Foreground="#17243A"/>
                <TextBlock Text="Filo kayıtlarını ve araç bilgilerini yönetin."
                           FontSize="13" Foreground="#718096"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOPLAM ARAÇ" Foreground="#718096"
                                   FontSize="11"/>
                        <TextBlock x:Name="ToplamAracText" Text="0"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="#17243A" Margin="0,8,0,0"/>
                        <TextBlock Text="Kayıtlı araç sayısı"
                                   Foreground="#8793A5" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="AKTİF ARAÇ" Foreground="#718096"
                                   FontSize="11"/>
                        <TextBlock x:Name="AktifAracText" Text="0"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="#16856B" Margin="0,8,0,0"/>
                        <TextBlock Text="Aktif kayıtlar"
                                   Foreground="#8793A5" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FİLO KAPASİTESİ"
                                   Foreground="#718096" FontSize="11"/>
                        <TextBlock x:Name="ToplamKapasiteText" Text="0 ton"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="#315D91" Margin="0,8,0,0"/>
                        <TextBlock Text="Toplam taşıma kapasitesi"
                                   Foreground="#8793A5" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Yeni Araç Kaydı" FontSize="16"
                               FontWeight="Bold" Foreground="#17243A"
                               Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Plaka" Foreground="#536176"
                                       FontSize="12"/>
                            <TextBox x:Name="PlakaTextBox" Height="36"
                                     Padding="8" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Marka" Foreground="#536176"
                                       FontSize="12"/>
                            <TextBox x:Name="MarkaTextBox" Height="36"
                                     Padding="8" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Kapasite (ton)"
                                       Foreground="#536176" FontSize="12"/>
                            <TextBox x:Name="KapasiteTextBox" Height="36"
                                     Padding="8" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="+ Araç Ekle"
                                Click="AracEkleButton_Click"
                                Height="36" MinWidth="115"
                                Padding="12,0" Margin="0,22,0,0"
                                Background="#315D91" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White"
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Kayıtlı Araçlar" FontSize="16"
                               FontWeight="Bold" Foreground="#17243A"
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" x:Name="AraclarDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="38" ColumnHeaderHeight="38"
                              Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plaka"
                                                Binding="{Binding Plaka}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Marka"
                                                Binding="{Binding Marka}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Kapasite (ton)"
                                                Binding="{Binding KapasiteTon}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Model Yılı"
                                                Binding="{Binding ModelYili}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


